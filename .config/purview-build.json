{
	"Build": {
		"Solution": "src/ZodSharp.slnx",
		"TestRoot": "src/tests",
		"TestPatterns": "*Tests.csproj",
		"TestFilter": "/*/*/*/*",
		// The vendored CSharpier (an unreleased build that parses C# 15 `union`), the same binary the Justfile
		// lint recipes run. Without this the pipeline lints with the tool-manifest 1.3.0, which formats lambda
		// arguments differently, so `just lint-fix` output fails the pipeline's lint gate.
		"CSharpierPath": ".assets/csharpier/CSharpier.dll"
	},
	"PackValidation": {
		// Explicit because Purview.Build 0.5.3 defaults RequiredCompilerFlags to empty. Earlier
		// versions forced this check on and could not be configured off, so these packages have
		// always been validated against it; declaring it keeps that behaviour.
		"RequiredCompilerFlags": [
			"optimization=release"
		],
		"RequireSymbolPackage": true,
		"RequireSymbolFiles": true,
		"RequiredContent": {
			"purview.zodsharp": [
				"analyzers/dotnet/cs/Purview.ZodSharp.CodeFixes.dll",
				"analyzers/dotnet/cs/Purview.ZodSharp.SourceGenerators.dll",
				"buildTransitive/Purview.ZodSharp.props",
				"buildTransitive/Purview.ZodSharp.targets",
				"lib/$(TFM)/Purview.ZodSharp.dll",
				"lib/$(TFM)/Purview.ZodSharp.xml",
				"purview-logo-light.png",
				"README.md"
			],
			"purview.zodsharp.aspnetcore": [
				"lib/$(TFM)/Purview.ZodSharp.AspNetCore.dll",
				"lib/$(TFM)/Purview.ZodSharp.AspNetCore.xml",
				"purview-logo-light.png",
				"README.md"
			],
			"purview.zodsharp.blazor": [
				"build/Microsoft.AspNetCore.StaticWebAssets.targets",
				"build/Purview.ZodSharp.Blazor.PackageAssets.json",
				"build/Purview.ZodSharp.Blazor.targets",
				"buildMultiTargeting/Purview.ZodSharp.Blazor.targets",
				"buildTransitive/Purview.ZodSharp.Blazor.targets",
				"lib/$(TFM)/Purview.ZodSharp.Blazor.dll",
				"lib/$(TFM)/Purview.ZodSharp.Blazor.xml",
				"staticwebassets/zodsharp-validation.js",
				// The JavaScript initializer is fingerprinted by content, so its name carries a hash.
				"staticwebassets/Purview.ZodSharp.Blazor.*.lib.module.js",
				"purview-logo-light.png",
				"README.md"
			],
			"purview.zodsharp.extensions.validation": [
				"lib/$(TFM)/Purview.ZodSharp.Extensions.Validation.dll",
				"lib/$(TFM)/Purview.ZodSharp.Extensions.Validation.xml",
				"purview-logo-light.png",
				"README.md"
			],
			"purview.zodsharp.aspnetcore.openapi": [
				"lib/$(TFM)/Purview.ZodSharp.AspNetCore.OpenApi.dll",
				"lib/$(TFM)/Purview.ZodSharp.AspNetCore.OpenApi.xml",
				"purview-logo-light.png",
				"README.md"
			],
			"purview.zodsharp.newtonsoftjson": [
				"lib/$(TFM)/Purview.ZodSharp.NewtonsoftJson.dll",
				"lib/$(TFM)/Purview.ZodSharp.NewtonsoftJson.xml",
				"purview-logo-light.png",
				"README.md"
			],
			"purview.zodsharp.systemtextjson": [
				"lib/$(TFM)/Purview.ZodSharp.SystemTextJson.dll",
				"lib/$(TFM)/Purview.ZodSharp.SystemTextJson.xml",
				"purview-logo-light.png",
				"README.md"
			]
		},
		// Every package ("*"). RequireExplicitContent (on by default) already rejects anything RequiredContent does not
		// declare; these rules hold even if a RequiredContent glob is ever widened. Globs are
		// Microsoft.Extensions.FileSystemGlobbing patterns: "*" stays within one path segment, "**" spans any number,
		// including none. scripts/test-pack-validation-rules.ps1 injects a file for every rule into a scratch copy of
		// each package and proves the validation fails.
		"ForbiddenContent": {
			"*": [
				// The generator ships IL-merged, with Purview.SourceGeneratorFramework internalized into it; a loose copy
				// under analyzers/ means the merge did not run.
				"analyzers/**/Purview.SourceGeneratorFramework*",
				// The compiler supplies Roslyn to analyzers; a packed copy would shadow or conflict with it.
				"analyzers/**/Microsoft.CodeAnalysis*",
				// Compiler-host assemblies never appear outside analyzers/: anywhere else NuGet hands them to the
				// application, which is how Purview.SourceGeneratorFramework.dll reached app and Blazor WebAssembly
				// output and broke WebAssembly AOT compilation.
				"Purview.SourceGeneratorFramework*",
				"Microsoft.CodeAnalysis*",
				"lib/**/Purview.SourceGeneratorFramework*",
				"lib/**/Microsoft.CodeAnalysis*",
				"ref/**/Purview.SourceGeneratorFramework*",
				"ref/**/Microsoft.CodeAnalysis*",
				"runtimes/**/Purview.SourceGeneratorFramework*",
				"runtimes/**/Microsoft.CodeAnalysis*",
				"build/**/Purview.SourceGeneratorFramework*",
				"build/**/Microsoft.CodeAnalysis*",
				"buildTransitive/**/Purview.SourceGeneratorFramework*",
				"buildTransitive/**/Microsoft.CodeAnalysis*",
				"buildMultiTargeting/**/Purview.SourceGeneratorFramework*",
				"buildMultiTargeting/**/Microsoft.CodeAnalysis*",
				"tools/**/Purview.SourceGeneratorFramework*",
				"tools/**/Microsoft.CodeAnalysis*",
				"content/**/Purview.SourceGeneratorFramework*",
				"content/**/Microsoft.CodeAnalysis*",
				"contentFiles/**/Purview.SourceGeneratorFramework*",
				"contentFiles/**/Microsoft.CodeAnalysis*",
				"staticwebassets/**/Purview.SourceGeneratorFramework*",
				"staticwebassets/**/Microsoft.CodeAnalysis*",
				// The generator and the code fixes run only inside the compiler, so they ship under analyzers/ alone:
				// under lib/, ref/ or runtimes/ every application would load them.
				"lib/**/Purview.ZodSharp.SourceGenerators*",
				"lib/**/Purview.ZodSharp.CodeFixes*",
				"ref/**/Purview.ZodSharp.SourceGenerators*",
				"ref/**/Purview.ZodSharp.CodeFixes*",
				"runtimes/**/Purview.ZodSharp.SourceGenerators*",
				"runtimes/**/Purview.ZodSharp.CodeFixes*"
			]
		}
	},
	"Release": {
		"Mode": "None"
	}
}