<Project>
	<PropertyGroup>
		<!-- Every .NET release still in support (net10.0;net11.0), resolved by Purview.BuildSdk rather than
		     listed here, so a runtime lifecycle change is an SDK bump instead of an edit in this file.
		     net8.0 and net9.0 were dropped in 3.0.0. -->
		<PurviewTargetFrameworkSet>Supported</PurviewTargetFrameworkSet>
		<!-- `preview`, not `latest`: Purview.BuildSdk opts every net11.0+ target into the C# 15 *updated
		     memory-safety rules* (MemorySafetyRules=2), and the .NET 11 GA compiler still classifies that
		     feature as preview (CS8652 without `preview`). The two places this repository crosses the
		     unmanaged boundary (`Unsafe.As` in the sentinel/required rules) wrap each read in an `unsafe`
		     block, so the audit boundary is visible at the call site. C# 15 is the default for net11.0 and
		     is still accepted by the net10.0 target. -->
		<LangVersion>preview</LangVersion>
		<!--
			The .NET 11 System.Text.Json source generator emits unsafe code for its fast paths, so every
			project that uses it needs the option even when the project itself has no pointer code. Only the
			sentinel/required rules use it deliberately (see ZodSharp.csproj).
		-->
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<!--
			Runtime Async stays off. Purview.BuildSdk 2.0 turns `runtime-async=on` on for every net11.0 target,
			but Runtime Async is not supported by Mono, and Mono is the runtime behind Blazor WebAssembly.
			3.0.0-prerelease.5 shipped with it on and a wasm consumer failed at its first validation with an
			empty InvalidProgramException raised from the AsyncHelpers.Await IL
			(dotnet/aspnetcore#68067: "Runtime async is not supported for Mono"; ASP.NET Core itself
			compiles with `runtime-async=off` whenever the target is browser). Almost everything shipped here is
			browser-facing - the core package, SystemTextJson, Http and Blazor - so the whole repository opts
			out instead of carrying a per-project split that would still leave the core library unusable on
			WebAssembly. The C# 15 updated memory-safety rules are independent of this and stay on.
		-->
		<PurviewRuntimeAsync>false</PurviewRuntimeAsync>
		<NamespacePrefix>ZodSharp</NamespacePrefix>
		<!-- Set project-by-project -->
		<IsPackable>false</IsPackable>
		<ExcludePurviewTelemetry>true</ExcludePurviewTelemetry>
		<RepositoryUrl>https://github.com/purview-dev/zodsharp</RepositoryUrl>
		<NoWarn>$(NoWarn);CA1031;CA1307;CA1510;</NoWarn>
		<!-- Installed skills live in the universal .agents/skills/ folder only, and are committed. The
		     SDK's default (*) would make InstallPurviewSkills write a copy into every agent's folder. -->
		<PurviewSkillsAgents>universal</PurviewSkillsAgents>
		<!--
			MSBuild's multithreaded build stays off until the WebAssembly SDK can run its tasks in it:
			.NET 11 GA's Microsoft.NET.Runtime.WebAssembly.Sdk declares `ReadWasmProps` with a custom
			TaskFactory, which multithreaded mode refuses to execute out of process
			("does not support out of process TaskHost execution"), so Examples.Blazor.Client could not
			build. The SDK writes `-mt:false` into the managed Directory.Build.rsp; delete this property
			(and the rsp) once dotnet/runtime ships a multithreadable-annotated task.
		-->
		<PurviewMultiThreadedBuild>false</PurviewMultiThreadedBuild>
	</PropertyGroup>

	<Import Sdk="Purview.BuildSdk" Project="Sdk.props" />

	<PropertyGroup>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
	</PropertyGroup>

	<!-- Test and executable projects follow the same set. The SDK gives a non-Roslyn project the set's
	     targets already; this re-asserts it for projects where another default got in first. -->
	<PropertyGroup Condition="'$(IsTestProject)' == 'true' OR '$(OutputType)' == 'Exe'">
		<TargetFramework></TargetFramework>
		<TargetFrameworks>$(PurviewTargetFrameworksSupported)</TargetFrameworks>
	</PropertyGroup>

	<PropertyGroup Label="Purview site URL metadata">
		<PurviewHomepage>https://purview.dev/</PurviewHomepage>
		<PurviewProjectUrl>$(PurviewHomepage)projects/zodsharp/</PurviewProjectUrl>
		<PurviewDocsUrl>$(PurviewHomepage)docs/zodsharp/</PurviewDocsUrl>
	</PropertyGroup>

	<PropertyGroup Label="NuGet package metadata" Condition="'$(IsPackable)' == 'true'">
		<Authors>ZodSharp Contributors;Purview-Dev Contributors</Authors>
		<Company>Purview.dev</Company>
		<PackageProjectUrl>$(PurviewProjectUrl)</PackageProjectUrl>
		<RepositoryUrl>$(RepositoryUrl)</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<PackageIcon>purview-logo-light.png</PackageIcon>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
	</PropertyGroup>

	<ItemGroup Label="NuGet package assets" Condition="'$(IsPackable)' == 'true'">
		<None
			Include="$(MSBuildThisFileDirectory)/../assets/images/purview-logo-light.png"
			Link="Sdk/purview-logo-light.png"
		/>
	</ItemGroup>
</Project>
