<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<AssemblyName>Purview.ZodSharp.SourceGenerators.UnitTests</AssemblyName>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
		<PackageReference Include="Purview.SourceGeneratorFramework.Testing.TUnit" />
		<!-- The consumer generates time-bound identifiers with FastGuid; the cross-platform parity test uses
		     real FastGuid values to prove the exported schema accepts them (they are not RFC UUIDs). -->
		<PackageReference Include="FastGuid" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\src\ZodSharp\ZodSharp.csproj" />
		<!-- Reference the code-fix assembly normally so code-fix tests can instantiate the provider. -->
		<ProjectReference
			Include="..\..\src\CodeFixes\CodeFixes.csproj"
			ReferenceOutputAssembly="true"
			PrivateAssets="all"
		/>
		<!-- Reference the generator assembly normally so the test code can use ZodSchemaGenerator. -->
		<ProjectReference
			Include="..\..\src\SourceGenerators\SourceGenerators.csproj"
			ReferenceOutputAssembly="true"
			PrivateAssets="all"
		/>
	</ItemGroup>
</Project>
