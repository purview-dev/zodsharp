<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<AssemblyName>Purview.ZodSharp.AspNetCore.SourceGenerators.UnitTests</AssemblyName>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
		<PackageReference Include="Purview.SourceGeneratorFramework.Testing.TUnit" />
	</ItemGroup>

	<ItemGroup>
		<!-- Reference the real ErrorType/ValidationError/ZodException types so the test
		     compilation does not rely on stubbed copies. -->
		<ProjectReference Include="..\..\src\AspNetCore\AspNetCore.csproj" />
		<!-- Reference the generator assembly normally so the test code can use ErrorTypeGenerator. -->
		<ProjectReference
			Include="..\..\src\AspNetCore.SourceGenerators\AspNetCore.SourceGenerators.csproj"
			ReferenceOutputAssembly="true"
			PrivateAssets="all"
		/>
	</ItemGroup>
</Project>
