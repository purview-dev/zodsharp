<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<AutoIncludeUsings>false</AutoIncludeUsings>
		<RootNamespace>ZodSharp</RootNamespace>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
	</PropertyGroup>

	<PropertyGroup>
		<IsPackable>true</IsPackable>
		<AssemblyName>Purview.ZodSharp.NewtonsoftJson</AssemblyName>
		<PackageId>Purview.ZodSharp.NewtonsoftJson</PackageId>
		<Description>A high-performance C# port of Zod schema validation library. Features zero-allocation validation, struct-based rules, fluent API, and source generator support for maximum performance.</Description>
		<PackageTags>zod;validation;schema;json</PackageTags>
	</PropertyGroup>

	<!--
		Trimming and Native AOT. Newtonsoft.Json is reflection-based throughout and carries no trimming annotations,
		so the analyzers cannot see its hazards. Every public API here that reaches Newtonsoft serialization declares
		[RequiresUnreferencedCode]/[RequiresDynamicCode] itself (NewtonsoftJsonTrimming.Message), which makes the
		package analyzer-clean and honest: a trimmed or AOT consumer is warned at the call site and pointed at
		Purview.ZodSharp.SystemTextJson.
	-->
	<PropertyGroup Label="Trimming and Native AOT">
		<IsAotCompatible>true</IsAotCompatible>
		<IsTrimmable>true</IsTrimmable>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Newtonsoft.Json" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\ZodSharp\ZodSharp.csproj" />
	</ItemGroup>
</Project>
