@using System.Globalization
<!DOCTYPE html>
<html lang="@CultureInfo.CurrentUICulture.TwoLetterISOLanguageName">

<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<base href="/" />
	<link rel="icon" href="data:," />
	<ResourcePreloader />
	<link rel="stylesheet" href="@Assets["app.css"]" />
	<ImportMap />
	<HeadOutlet />
	@* The WebAssembly client reads the culture the server rendered the page in (SampleLocalization). *@
	<script>window.zodSharpSample = { culture: () => document.documentElement.lang };</script>
</head>

<body>
	<Routes />
	<script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>
