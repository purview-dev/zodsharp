<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFrameworks>net10.0;net11.0</TargetFrameworks>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<RootNamespace>ZodSharp</RootNamespace>
		<NoWarn>$(NoWarn);CA1303;CA1707;CA1822;CA1515;</NoWarn>
		<OutputType>Exe</OutputType>
		<IsPackable>false</IsPackable>
		<!-- Do not change this, as BenchmarkDotNet relies on the assembly name -->
		<AssemblyName>Benchmarks</AssemblyName>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\ZodSharp\ZodSharp.csproj" />
		<ProjectReference Include="..\AspNetCore\AspNetCore.csproj" />
		<!-- The generated-validation benchmarks need the [ZodSchema] generator (added as an analyzer below). -->
		<ProjectReference
			Include="..\SourceGenerators\SourceGenerators.csproj"
			ReferenceOutputAssembly="false"
			PrivateAssets="all"
		/>
	</ItemGroup>

	<!--
		This project does not import Purview.BuildSdk (see Directory.Build.props), so nothing swaps the
		generator's unmerged bin assembly for the merged, self-contained one. Resolve the merged generator the
		same way the package does and hand it to the compiler.
	-->
	<Target Name="AddMergedZodSharpGenerator" AfterTargets="ResolveProjectReferences" BeforeTargets="CoreCompile">
		<MSBuild
			Projects="..\SourceGenerators\SourceGenerators.csproj"
			Targets="GetPurviewMergedAnalyzerFile"
			Properties="Configuration=$(Configuration)"
			RemoveProperties="TargetFramework;TargetFrameworks;RuntimeIdentifier;SelfContained"
		>
			<Output TaskParameter="TargetOutputs" ItemName="_ZodSharpMergedGenerator" />
		</MSBuild>
		<ItemGroup>
			<Analyzer Include="@(_ZodSharpMergedGenerator)" />
		</ItemGroup>
	</Target>

	<ItemGroup>
		<PackageReference Include="BenchmarkDotNet" />
		<PackageReference Include="Newtonsoft.Json" />
	</ItemGroup>
</Project>
