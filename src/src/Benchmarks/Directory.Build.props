<Project>
	<!--
    Deliberately empty: shadows src/Directory.Build.props for this subtree.

    BenchmarkDotNet generates its autogenerated project under this project's
    bin/ folder. Its csproj sets ImportDirectoryBuildProps=false in the project
    body, but MSBuild imports Directory.Build.props during Sdk.props evaluation
    (before the project body), so src/Directory.Build.props still leaks into the
    autogenerated project. The Purview.BuildSdk then derives a
    RootNamespace of "ZodSharp.BenchmarkDotNet.Autogenerated" and injects a
    "global using" for it, which fails to compile (CS0234) because the generated
    runner code lives in the "BenchmarkDotNet.Autogenerated" namespace.

    This empty file (and the matching Directory.Build.targets) stops that from
    happening for the benchmark project and anything under it, including
    BenchmarkDotNet's generated build output. The Benchmarks.csproj is fully
    self-contained and does not need the SDK.
  -->
</Project>
