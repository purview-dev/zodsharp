<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
	<PropertyGroup>
		<!--
			The WebAssembly half of the Blazor sample: the interactive WebAssembly form, compiled for the browser. net11.0
			only, like Purview.ZodSharp.Blazor.
		-->
		<TargetFramework>net11.0</TargetFramework>
		<TargetFrameworks></TargetFrameworks>
		<!--
			Purview.BuildSdk defaults every project to IsPublishable=false. CI publishes this one trimmed (wasm-trimmed)
			and with RunAOTCompilation (wasm-aot), failing on any IL2xxx/IL3xxx warning, which is the proof that the
			Blazor integration is trim-safe in the browser. Never packed.
		-->
		<IsPublishable>true</IsPublishable>
		<IsPackable>false</IsPackable>
		<NoDefaultLaunchSettingsFile>true</NoDefaultLaunchSettingsFile>
		<StaticWebAssetProjectMode>Default</StaticWebAssetProjectMode>
		<!-- Trimming is the WebAssembly default for Release publishes; stated so the intent is explicit. -->
		<PublishTrimmed>true</PublishTrimmed>
		<EnableTrimAnalyzer>true</EnableTrimAnalyzer>
		<!-- Report every trim warning individually rather than one summary warning per assembly. -->
		<TrimmerSingleWarn>false</TrimmerSingleWarn>
		<!-- The sample switches between English and French, so it needs culture data and satellite assemblies. -->
		<InvariantGlobalization>false</InvariantGlobalization>
		<BlazorWebAssemblyLoadAllGlobalizationData>true</BlazorWebAssemblyLoadAllGlobalizationData>
		<!-- A browser has no use for the XML documentation file. -->
		<PublishDocumentationFile>false</PublishDocumentationFile>
		<EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
		<!--
			Directory.Packages.props picks the Microsoft.Extensions line by $(TargetFramework), which a single-targeted
			project has not set yet when that file is evaluated; the WebAssembly packages need the 11.x line.
		-->
		<MicrosoftExtensionsVersion>11.0.0</MicrosoftExtensionsVersion>
	</PropertyGroup>

	<ItemGroup>
		<!--
			No direct Microsoft.Extensions.Validation reference and no [ValidatableType]: the [ZodSchema] models in
			Examples.Shared still validate nested members, collections and dictionaries in the browser, because the
			ZodSharp resolver supplies their type info.
		-->
		<ProjectReference Include="..\Blazor\Blazor.csproj" />
		<ProjectReference Include="..\Examples.Shared\Examples.Shared.csproj" />
		<!-- Validated HTTP bodies (ReadFromJsonAndValidateAsync); published trimmed and AOT-compiled with the client. -->
		<ProjectReference Include="..\Http\Http.csproj" />
		<ProjectReference Include="..\ZodSharp\ZodSharp.csproj" />
		<!-- Direct reference required when we're using a local project ref: the client's own [ZodSchema] contracts. -->
		<ProjectReference
			Include="..\SourceGenerators\SourceGenerators.csproj"
			OutputItemType="Analyzer"
			ReferenceOutputAssembly="false"
			PrivateAssets="all"
		/>
	</ItemGroup>

	<ItemGroup>
		<!--
			The contracts, the resources marker and the localization setup are internal; the server project uses them too,
			as a Blazor Web App's server always references its client.
		-->
		<InternalsVisibleTo Include="ZodSharp.Examples.Blazor" />
		<!-- The integration tests drive CustomerApiClient against the real API. -->
		<InternalsVisibleTo Include="ZodSharp.Examples.Blazor.IntegrationTests" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
		<PackageReference Include="Microsoft.Extensions.Localization" />
	</ItemGroup>

	<!--
		Like Purview.ZodSharp.Blazor, the client must not run the Microsoft.Extensions.Validation generator (it flows in
		transitively through the bridge): the sample demonstrates that [ZodSchema] models need none of it.
	-->
	<Target Name="RemoveValidationsGenerator" AfterTargets="ResolveLockFileAnalyzers" BeforeTargets="CoreCompile">
		<ItemGroup>
			<Analyzer
				Remove="@(Analyzer)"
				Condition="'%(Filename)' == 'Microsoft.Extensions.Validation.ValidationsGenerator'"
			/>
		</ItemGroup>
	</Target>

	<!-- The Purview.ZodSharp package ships this through buildTransitive; a ProjectReference does not import it. -->
	<Import Project="..\ZodSharp\Sdk\buildTransitive\Purview.ZodSharp.targets" />
</Project>
