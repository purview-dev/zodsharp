<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFrameworks>$(PurviewTargetFrameworksAll)</TargetFrameworks>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<!--
			Trimming and Native AOT. Verified clean under both analyzers. Graph-based assembly scanning
			(ScanAssemblyGraphs) and validator discovery remain reflective by nature; they are documented as
			the paths a trimmed or AOT host should avoid in favour of explicit registration.
		-->
		<IsAotCompatible>true</IsAotCompatible>
		<IsPackable>true</IsPackable>
		<PackageId>Purview.ZodSharp.AspNetCore</PackageId>
		<AssemblyName>Purview.ZodSharp.AspNetCore</AssemblyName>
		<Description>ASP.NET Core ProblemDetails integration for ZodSharp validation results.</Description>
		<PackageTags>zod;validation;aspnetcore;problemdetails</PackageTags>
	</PropertyGroup>

	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\ZodSharp\ZodSharp.csproj" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net11.0'">
		<!--
			net11.0 only: the Microsoft.Extensions.Validation bridge exists only there. It supplies the report sink
			that AddZodSharpProblemDetails uses to enrich the built-in validation pipeline's ProblemDetails, so the
			package dependency appears in the net11.0 group alone.
		-->
		<ProjectReference Include="..\Extensions.Validation\Extensions.Validation.csproj" />
	</ItemGroup>
</Project>
