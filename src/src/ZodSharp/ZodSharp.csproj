<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<!-- Downloaded to and run in the browser by Blazor WebAssembly clients: the SDK's browser-safe defaults fail the
			build on trim, AOT and browser-unsupported APIs (and satisfy the client's PRBLZ0001 reference check). -->
		<PurviewBrowserSafe>true</PurviewBrowserSafe>
		<IsPackable>true</IsPackable>
		<PackageId>Purview.ZodSharp</PackageId>
		<AssemblyName>Purview.ZodSharp</AssemblyName>
		<Description>
			A high-performance C# port of Zod schema validation library.
			Features zero-allocation validation, struct-based rules, fluent API,
			and source generator support for maximum performance.
		</Description>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<PackageTags>zod;validation;schema</PackageTags>
		<!--
			Trimming and Native AOT. IsAotCompatible turns on IsTrimmable plus both analyzers, so a regression
			is a build warning here rather than a runtime failure in a consumer's published application.

			This package is clean under both. Getting there removed the JSON Schema exporter's reflection into
			its own private fields, which was not only untrimmable but silently wrong: it looked up field and
			rule-type names that did not exist, so object properties, array bounds and element schemas,
			optional inner schemas and union options were all missing from exported schemas.

			RegisterFromAssembly stays reflective by nature and declares [RequiresUnreferencedCode]; the
			discriminated-union accessor falls back to plain reflection when dynamic code is unavailable.

			The integration packages are NOT marked: Purview.ZodSharp.NewtonsoftJson cannot be, because
			Newtonsoft.Json is reflection-based throughout, and Purview.ZodSharp.SystemTextJson needs
			JsonTypeInfo/JsonSerializerContext overloads first.
		-->
		<IsAotCompatible>true</IsAotCompatible>
		<NoWarn>$(NoWarn);NU5118</NoWarn>
		<!--
			The source generator is packed as a self-contained (merged) assembly through
			Purview.SourceGeneratorFramework's GetPurviewMergedAnalyzerFile, so the default
			GASF-based analyzer packing (which would also ship the loose framework DLL) is disabled.
		-->
		<PackProjectReferencedSourceGenerators>false</PackProjectReferencedSourceGenerators>
		<TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);PackZodSchemaGenerator;PackZodSharpCodeFixes</TargetsForTfmSpecificContentInPackage>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference
			Include="../SourceGenerators/SourceGenerators.csproj"
			PrivateAssets="all"
			ReferenceOutputAssembly="false"
			OutputItemType="Analyzer"
		/>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
		<PackageReference Include="Microsoft.Extensions.Options" />
	</ItemGroup>

	<!--
		Packs the merged, self-contained source generator under analyzers/dotnet/cs. The
		SourceGenerators project references Purview.SourceGeneratorFramework, whose build target
		GetPurviewMergedAnalyzerFile produces the merged assembly (framework implementation
		internalized) and returns it without touching the project's bin output, so in-repo tests keep
		the unmerged generator.
	-->
	<Target Name="PackZodSchemaGenerator" Label="Packs the self-contained ZodSharp source generator.">
		<MSBuild
			Projects="../SourceGenerators/SourceGenerators.csproj"
			Targets="GetPurviewMergedAnalyzerFile"
			Properties="Configuration=$(Configuration)"
			RemoveProperties="TargetFramework;TargetFrameworks;RuntimeIdentifier;SelfContained"
		>
			<Output TaskParameter="TargetOutputs" ItemName="_PurviewZodSharpMergedGenerator" />
		</MSBuild>
		<ItemGroup>
			<TfmSpecificPackageFile Include="@(_PurviewZodSharpMergedGenerator)">
				<PackagePath>analyzers/dotnet/cs/</PackagePath>
			</TfmSpecificPackageFile>
		</ItemGroup>
	</Target>

	<!--
		Packs the code-fix assembly (which must live outside the generator/analyzer assembly because
		RS1038 forbids an assembly containing Roslyn analyzers/generators from referencing
		Microsoft.CodeAnalysis.Workspaces) alongside the merged generator under analyzers/dotnet/cs.
	-->
	<Target Name="PackZodSharpCodeFixes" Label="Packs the ZodSharp code-fix assembly.">
		<MSBuild
			Projects="../CodeFixes/CodeFixes.csproj"
			Targets="Build;GetTargetPath"
			Properties="Configuration=$(Configuration)"
			RemoveProperties="TargetFramework;TargetFrameworks;RuntimeIdentifier;SelfContained"
		>
			<Output TaskParameter="TargetOutputs" ItemName="_PurviewZodSharpCodeFixes" />
		</MSBuild>
		<ItemGroup>
			<TfmSpecificPackageFile Include="@(_PurviewZodSharpCodeFixes)">
				<PackagePath>analyzers/dotnet/cs/</PackagePath>
			</TfmSpecificPackageFile>
		</ItemGroup>
	</Target>
</Project>
