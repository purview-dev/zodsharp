<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<!--
			net11.0 only. ASP.NET Core 11 moved Microsoft.AspNetCore.OpenApi onto the Microsoft.OpenApi 3.x object
			model, a breaking change from the 2.x model .NET 10 uses; supporting an earlier framework would mean a
			second implementation rather than a TFM switch.
		-->
		<TargetFramework>net11.0</TargetFramework>
		<TargetFrameworks></TargetFrameworks>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<IsAotCompatible>true</IsAotCompatible>
		<IsPackable>true</IsPackable>
		<!-- A new package has no previous release to validate against. -->
		<DisablePackageBaselineValidation>true</DisablePackageBaselineValidation>
		<!-- NU5104: ASP.NET Core 11 has only shipped release candidates, so the Microsoft.AspNetCore.OpenApi
		     dependency is a prerelease. Remove once 11.0.0 is released and Directory.Packages.props is updated. -->
		<NoWarn>$(NoWarn);NU5104</NoWarn>
		<RootNamespace>ZodSharp.AspNetCore.OpenApi</RootNamespace>
		<PackageId>Purview.ZodSharp.AspNetCore.OpenApi</PackageId>
		<AssemblyName>Purview.ZodSharp.AspNetCore.OpenApi</AssemblyName>
		<Description>OpenAPI transformers for ASP.NET Core that describe the constraints, formats, unions and error contract ZodSharp enforces.</Description>
		<PackageTags>zod;validation;aspnetcore;openapi;jsonschema</PackageTags>
	</PropertyGroup>

	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
		<!--
			PrivateAssets="none": Microsoft.AspNetCore.OpenApi's source generator reaches a consumer that references only
			this package, so its build/ targets must too - they enable the generator's interceptors
			(InterceptorsNamespaces). With the default private assets the dependency excluded Build, and AddOpenApi(...)
			failed to compile with CS9137. scripts/test-packed-consumers.ps1 builds such a consumer.
		-->
		<PackageReference Include="Microsoft.AspNetCore.OpenApi" PrivateAssets="none" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\AspNetCore\AspNetCore.csproj" />
	</ItemGroup>
</Project>
