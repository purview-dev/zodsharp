<Project>
	<Import Sdk="Purview.BuildSdk" Project="Sdk.targets" />

	<!--
		NuGet package validation. Enabled for every packable project so an unintended change to the public API
		fails `dotnet pack` instead of shipping. The baseline is the previous stable release; bump it when a new
		version ships. This lives in the repo because the baseline is package-specific; Purview.BuildSdk has no
		default for it.

		3.0.0 validates against 2.4.2. It drops net8.0 and net9.0, so every project that shipped in 2.4.2 carries a
		CompatibilitySuppressions.xml for the removed target frameworks (and any intended API change). An intended
		change needs a CompatibilitySuppressions.xml next to the project that owns it (generate one with
		`dotnet pack /p:GenerateCompatibilitySuppressionFile=true`), and that file is then the evidence behind the
		matching upgrade note — a change that is not listed in both is a defect.
	-->
	<PropertyGroup Label="NuGet package validation" Condition="'$(IsPackable)' == 'true'">
		<EnablePackageValidation>true</EnablePackageValidation>
		<!-- A package that has never shipped sets ZodSharpNoPackageValidationBaseline; it still gets the
		     cross-TFM checks, just no previous version to compare against. -->
		<PackageValidationBaselineVersion>2.4.2</PackageValidationBaselineVersion>
		<PackageValidationBaselineVersion Condition="'$(ZodSharpNoPackageValidationBaseline)' == 'true'" />
	</PropertyGroup>
</Project>
